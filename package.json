{
  "name": "nodecloak",
  "private": true,
  "version": "5.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build --config vite.admin.config.ts",
    "dev:admin": "vite --config vite.admin.config.ts --host 127.0.0.1 --port 1422",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:session-codec": "node --test scripts/session-codec.checks.mjs",
    "test:firefox-extension": "node --test extensions/firefox/background.checks.mjs scripts/firefox-region.checks.mjs scripts/firefox-session.checks.mjs",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "lucide-react": "^0.468.0",
    "mdast-util-to-string": "^4.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodecloak/nodecloak.git"
  },
  "homepage": "https://nodecloak.com"
}
